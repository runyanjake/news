# Copy to .env and fill in. .env is git-ignored; never commit secrets.

# Local timezone; the daily render runs at RENDER_TIME in this zone.
TZ=America/Los_Angeles
RENDER_TIME=08:00

# Shared secret the renderer uses to trigger report generation on the backend.
ADMIN_TOKEN=change-me

# OpenAI-compatible LLM endpoint (Ollama: http://<host>:11434/v1).
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=llama3.1
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=120

# Public hostname Traefik routes to the container.
DOMAIN=news.example.com

# Secrets referenced from config/sources.yaml as ${NAME}, e.g.:
# TWITTER_BEARER_TOKEN=
